{
	"schemaVersion": 1,
	"id": "custom-sugarcane",
	"version": "${version}",
	"name": "Custom Sugarcane",
	"description": "This Mod adds custom sugarcane to Minecraft!",
	"authors": [
		"Timo"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/custom-sugarcane/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.timo.customsugarcane.CustomSugarcane"
		],
		"fabric-datagen": [
			"net.timo.customsugarcane.CustomSugarcaneDataGenerator"
		]
	},
	"mixins": [
		"custom-sugarcane.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
